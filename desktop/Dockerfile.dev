FROM golang:1.26-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libgl1-mesa-dev xorg-dev libxkbcommon-dev libwayland-dev wayland-protocols xvfb xauth file make \
    && rm -rf /var/lib/apt/lists/*

ARG UID=1000
ARG GID=1000
RUN groupadd -g ${GID} dev 2>/dev/null || true; \
    useradd -m -u ${UID} -g ${GID} dev 2>/dev/null || true; \
    mkdir -p /go/pkg /home/dev/.cache /home/dev/.config /home/dev/.local/share && chown -R ${UID}:${GID} /go /home/dev

USER ${UID}:${GID}
ENV GOCACHE=/home/dev/.cache/go-build GOFLAGS=-buildvcs=false HOME=/home/dev
WORKDIR /repo/desktop
